{
  "version": "2026-09-04",
  "_comment": "What an app store listing can declare, mapped to the words a privacy policy uses for the same thing. `store` holds the labels each store prints; `policy` holds case-insensitive patterns per language. A declared category the policy never mentions in any language is a contradiction the check reports.",
  "categories": [
    {
      "id": "location",
      "label": { "en": "location", "da": "placering", "de": "Standort" },
      "store": { "apple": ["Location"], "google": ["Location"] },
      "policy": {
        "en": ["\\blocation\\b", "\\bgps\\b", "geolocation"],
        "da": ["\\bplacering\\b", "\\blokation\\b", "\\bgps\\b", "geografisk"],
        "de": ["\\bstandort", "\\bgps\\b", "geolokation"]
      }
    },
    {
      "id": "contact-info",
      "label": { "en": "contact details", "da": "kontaktoplysninger", "de": "Kontaktdaten" },
      "store": { "apple": ["Contact Info"], "google": ["Personal info"] },
      "policy": {
        "en": ["\\bname\\b", "e-?mail", "\\bphone\\b", "\\baddress\\b"],
        "da": ["\\bnavn\\b", "e-?mail", "\\btelefon", "\\badresse\\b"],
        "de": ["\\bname\\b", "e-?mail", "\\btelefon", "\\badresse\\b", "\\banschrift\\b"]
      }
    },
    {
