{
  "name": "gdprcompliant-eu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:evals": "vitest run --project evals",
    "test:adversarial": "vitest run --project adversarial",
    "test:perf": "vitest run --project perf",
    "test:coverage:check": "vitest run --project unit --coverage",
    "proto": "node apps/prototype/smoke.mjs && node apps/prototype/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8",
    "@eslint/js": "^9.17.0"
  },
  "dependencies": {
    "@gc/contracts": "workspace:*",
    "@gc/db": "workspace:*",
    "@gc/scanner": "workspace:*",
    "@gc/findings": "workspace:*",
    "@gc/rules": "workspace:*",
    "@gc/remedies": "workspace:*",
    "@gc/agent": "workspace:*",
    "@gc/corpus": "workspace:*",
    "@gc/artefacts": "workspace:*"
  }
}
