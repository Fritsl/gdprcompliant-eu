  "version": "2026-09-04",
  "_comment": "The canary corpus (T-10): real, stable, public home pages scanned nightly and compared day over day. Only the home page and what it loads, three passes, one site at a time, at the pace below. A site that asks to be left out goes on the exclusion list with the date and stays there. The target is two hundred; this is the seed, chosen for being public institutions and large companies whose home pages change slowly.",
  "owner": {
    "name": "Frits Lyneborg",
    "contact": "fly@frits.ai",
    "role": "Owns the alarm: reads the nightly report, triages within one working day, and decides whether a change is the internet or the scanner."
  },
  "politeness": {
    "maxConcurrent": 1,
    "minIntervalMs": 5000,
    "passesPerSite": 3,
    "pagesPerSite": 1,
    "respectRobots": true,
    "userAgentNote": "The scanner identifies itself as GDPRcompliant-canary in the request headers of the passes that allow it; a Disallow for everyone in robots.txt skips the site."
  },
