# Copy to .env and fill in. Every variable is validated at boot by packages/config;
# a missing or malformed one stops the process with a message naming it.

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Postgres with pgvector. Local in development; in production the host must be
# declared in ENDPOINTS_EXTRA with purpose "database" and an EEA jurisdiction.
DATABASE_URL=postgres://gc:gc@localhost:5432/gdprcompliant

# Self-hosted models behind an OpenAI-compatible endpoint. Local hosts need no
# declaration; anything else must be in ENDPOINTS_EXTRA with purpose "model".
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=
MODEL_CHAT=llama-3.3-70b
MODEL_EMBEDDING=bge-m3

SCAN_CONCURRENCY=2

# Deployment-specific outbound hosts, on top of packages/config/endpoints.json.
# ENDPOINTS_EXTRA=[{"host":"llm.example.eu","purpose":"model","jurisdiction":"DK"}]

# Outbound calls: replay (from fixtures/cassettes, the default and what CI uses), record
# (live, and write the cassette), or live (no cassette). See TESTING.md.
GC_NETWORK=replay
